<Window x:Class="WordOllama.NewUI.ReviewSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WordOllama.NewUI" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{local:Loc I18n_ReviewSessionHistory}" Width="940" Height="520" MinWidth="760" MinHeight="380"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <materialDesign:BundledTheme BaseTheme="Inherit" PrimaryColor="Indigo" SecondaryColor="Indigo"/>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
        <ResourceDictionary Source="ModernStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{local:Loc I18n_ReviewSessionHistoryHint}" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <DataGrid Grid.Row="1" x:Name="SessionGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{local:Loc I18n_ReviewSessionRunTime}" Binding="{Binding RunTimeLabel}" Width="160"/>
                <DataGridTextColumn Header="{local:Loc I18n_ReviewSessionDocument}" Binding="{Binding DocumentName}" Width="*"/>
                <DataGridTextColumn Header="{local:Loc I18n_ReviewSessionModel}" Binding="{Binding ModelSettings.Model}" Width="150"/>
                <DataGridTextColumn Header="{local:Loc I18n_ReviewSessionState}" Binding="{Binding StateLabel}" Width="100"/>
                <DataGridTextColumn Header="{local:Loc I18n_ReviewSessionProgress}" Binding="{Binding ProgressLabel}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{local:Loc I18n_ReviewRestoreSession}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Click="Restore_Click" Margin="0,0,8,0"/>
            <Button Content="{local:Loc I18n_ReviewExportReport}" Style="{StaticResource MaterialDesignOutlinedButton}" Click="Export_Click" Margin="0,0,8,0"/>
            <Button Content="{local:Loc I18n_Cancel}" Style="{StaticResource MaterialDesignOutlinedButton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
