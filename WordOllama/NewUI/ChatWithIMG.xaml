<Window x:Class="WordOllama.NewUI.ChatWithIMG"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WordOllama.NewUI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:properties="clr-namespace:WordOllama.Properties"
        mc:Ignorable="d"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14"
        d:DesignHeight="600" d:DesignWidth="1000"
        Title="{x:Static properties:Resources.WINDOW_TITLE_IMAGE_UNDERSTANDING}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource MaterialDesignPaper}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Inherit" PrimaryColor="Indigo" SecondaryColor="Indigo" ColorAdjustment="{materialDesign:ColorAdjustment}"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.passwordBox.xaml" />
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <TabControl TabStripPlacement="Left" Padding="0" Margin="0">
        <TabItem Header="{x:Static properties:Resources.TAB_ANALYSIS}">
            <Grid Margin="24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Image selection and preview -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="txtImagePath"
                                 materialDesign:HintAssist.Hint="{x:Static properties:Resources.HINT_IMAGE_PATH}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 IsReadOnly="True" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" x:Name="btnSelectImage"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="btnSelectImage_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ImagePlus" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static properties:Resources.BUTTON_SELECT_IMAGE}"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderThickness="0" CornerRadius="12"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            Effect="{DynamicResource MaterialDesignShadowDepth1}">
                        <Image x:Name="imgPreview"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="8"/>
                    </Border>
                </Grid>

                <!-- Right: Prompt and results -->
                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderThickness="0" CornerRadius="12"
                            Margin="0,0,0,16"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            Effect="{DynamicResource MaterialDesignShadowDepth1}">
                        <Grid>
                            <TextBox x:Name="txtPrompt"
                                     materialDesign:HintAssist.Hint="{x:Static properties:Resources.HINT_PROMPT}"
                                     materialDesign:HintAssist.HelperText="{x:Static properties:Resources.HELPER_TEXT_PROMPT}"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     MinHeight="100" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Padding="12,10"/>
                            <Button ToolTip="{x:Static properties:Resources.BUTTON_OPTIMIZE}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,4,4" Padding="4"
                                    MinWidth="0" MinHeight="0"
                                    Background="Transparent" BorderThickness="0"
                                    Click="OptimizationButton_Click">
                                <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="btnProcess"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="40" Click="btnProcess_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Send" Margin="0,0,8,0"/>
                                <TextBlock Text="{x:Static properties:Resources.Common_Begin}"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="IMGModelNow"
                                   Text="{x:Static properties:Resources.LABEL_CURRENT_MODEL}"
                                   Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <Button x:Name="Copy_Btn" Grid.Column="2"
                                Click="Copy_Btn_Click" ToolTip="{x:Static properties:Resources.BUTTON_COPY_RESULT}">
                            <materialDesign:PackIcon Kind="ContentCopy"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2"
                            BorderThickness="0" CornerRadius="12"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            Effect="{DynamicResource MaterialDesignShadowDepth1}">
                        <TextBox x:Name="txtResult"
                                 materialDesign:HintAssist.Hint="{x:Static properties:Resources.结果将在这里显示}"
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="12,10"/>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="{x:Static properties:Resources.TAB_MODEL_MANAGEMENT}">
            <Grid Margin="28,20,28,20" MaxWidth="520">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Style="{StaticResource ModernSubHeader}" Text="{x:Static properties:Resources.Setting_O_MS}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <RadioButton x:Name="IMGGlobalModel" Content="{x:Static properties:Resources.全局模型}"
                                     GroupName="IMGMode" Margin="0,0,8,0"
                                     Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"/>
                        <RadioButton x:Name="IMGSelectModel" Content="{x:Static properties:Resources.特定模型}"
                                     GroupName="IMGMode" Margin="0,0,8,0"
                                     Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{x:Static properties:Resources.Ollama模型}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="OllamaModelSeletor" ItemsSource="{Binding OllamaModels}" DisplayMemberPath="Name"
                                  SelectedValuePath="ModelName" Style="{StaticResource MaterialDesignComboBox}"
                                  materialDesign:HintAssist.Hint="{x:Static properties:Resources.下拉选择模型}" FontSize="14"
                                  SelectionChanged="OllamaModelSeletor_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static properties:Resources.在线模型}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="OnlineModelSeletor" ItemsSource="{Binding OnlineModels}" DisplayMemberPath="ModelName"
                                  SelectedValuePath="Name" Style="{StaticResource MaterialDesignComboBox}"
                                  materialDesign:HintAssist.Hint="{x:Static properties:Resources.下拉选择模型}" FontSize="14"
                                  SelectionChanged="OnlineModelSeletor_SelectionChanged"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource ModernSubHeader}" Text="{x:Static properties:Resources.模型}"/>
                    <TextBox x:Name="IMGModel" Style="{StaticResource MaterialDesignTextBox}" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Style="{StaticResource ModernSubHeader}" Text="EndPoint"/>
                    <TextBox x:Name="IMGEndPoint" Style="{StaticResource MaterialDesignTextBox}" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Style="{StaticResource ModernSubHeader}" Text="API KEY"/>
                    <PasswordBox x:Name="IMGAPIKEY" FontSize="14" Margin="0,0,0,20"
                                 Style="{DynamicResource MaterialDesignRevealPasswordBox}"/>

                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            ToolTip="{x:Static properties:Resources.保存当前设置}"
                            HorizontalAlignment="Left"
                            Click="Save_btn_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static properties:Resources.Common_Save}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
