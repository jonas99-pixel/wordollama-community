<Window x:Class="WordOllama.NewUI.TranslatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WordOllama.NewUI"
        xmlns:forms="clr-namespace:WordOllama.Forms"
        Title="{local:Loc I18n_TranslatorTitle}" Height="720" Width="980"
        MinHeight="580" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource MaterialDesignPaper}">
    <forms:translatorUI />
</Window>
