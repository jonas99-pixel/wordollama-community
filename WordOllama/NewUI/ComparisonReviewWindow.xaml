<Window x:Class="WordOllama.NewUI.ComparisonReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WordOllama.NewUI" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{local:Loc I18n_ComparisonReview}" Width="820" Height="620" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <materialDesign:BundledTheme BaseTheme="Inherit" PrimaryColor="Indigo" SecondaryColor="Indigo"/>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
        <ResourceDictionary Source="ModernStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <TextBlock x:Name="Summary" Style="{StaticResource ModernSectionHeader}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{local:Loc I18n_AcceptAll}" Style="{StaticResource MaterialDesignOutlinedButton}" Click="AcceptAll_Click" Margin="0,0,8,0"/>
                <Button Content="{local:Loc I18n_RejectAll}" Style="{StaticResource MaterialDesignOutlinedButton}" Click="RejectAll_Click"/>
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" x:Name="RevisionGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}" SelectionMode="Single" MouseDoubleClick="Locate_Click">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding OriginalIndex}" Width="55"/>
                <DataGridTextColumn Header="{local:Loc I18n_RevisionType}" Binding="{Binding Type}" Width="120"/>
                <DataGridTextColumn Header="{local:Loc I18n_RevisionText}" Binding="{Binding Text}" Width="*"/>
                <DataGridTextColumn Header="{local:Loc I18n_Author}" Binding="{Binding Author}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{local:Loc I18n_Locate}" Style="{StaticResource MaterialDesignOutlinedButton}" Click="Locate_Click" Margin="0,0,8,0"/>
            <Button Content="{local:Loc I18n_Accept}" Style="{StaticResource MaterialDesignFlatMidBgButton}" Click="Accept_Click" Margin="0,0,8,0"/>
            <Button Content="{local:Loc I18n_Reject}" Style="{StaticResource MaterialDesignOutlinedButton}" Click="Reject_Click"/>
        </StackPanel>
    </Grid>
</Window>
