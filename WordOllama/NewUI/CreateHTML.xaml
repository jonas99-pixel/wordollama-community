<Window x:Class="WordOllama.NewUI.CreateHTML"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WordOllama.NewUI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:properties="clr-namespace:WordOllama.Properties"
        mc:Ignorable="d"
        d:DesignHeight="600" d:DesignWidth="860"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Ideal"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        Title="{x:Static properties:Resources.CreatHTML_Title}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Inherit" PrimaryColor="Indigo" SecondaryColor="Indigo" ColorAdjustment="{materialDesign:ColorAdjustment}"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DataGrid.xaml" />
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <local:LoadingOverlay x:Name="thisProgressBar" Panel.ZIndex="9999" />

        <TabControl TabStripPlacement="Left" Padding="0" Margin="0">
            <TabItem Header="{x:Static properties:Resources.CreatHTML_TabAI}">
                <Grid Margin="24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBox x:Name="promptTextBox"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="12,8,36,8"/>
                            <Button ToolTip="{x:Static properties:Resources.BUTTON_OPTIMIZE}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,14,8" Padding="4"
                                    MinWidth="0" MinHeight="0"
                                    Background="Transparent" BorderThickness="0"
                                    Click="OptimizationButton_Click">
                                <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <DockPanel Grid.Row="1" Margin="0,12,0,0">
                            <Button Content="{x:Static properties:Resources.Common_Begin}"
                                    x:Name="Begin_Btn" Click="SendPrompt_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    HorizontalAlignment="Right"/>
                            <TextBlock x:Name="HTMLModelNow" Text="Model Now"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </DockPanel>
                    </Grid>

                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" x:Name="htmlCodeTextBox"
                                 Text="{Binding HtmlCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="{x:Static properties:Resources.Common_Save}"
                                    Click="OpenPopup_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                            <Button Content="{x:Static properties:Resources.Common_Run}"
                                    Click="RunHtml_Click" Tag="NewAPP"
                                    Style="{StaticResource MaterialDesignRaisedButton}"/>
                        </StackPanel>
                    </Grid>

                    <Popup x:Name="AddHTMLPopup" PlacementTarget="{Binding ElementName=htmlCodeTextBox}"
                           Placement="Center" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                                Padding="24" CornerRadius="12"
                                Background="{DynamicResource MaterialDesignPaper}"
                                Effect="{DynamicResource MaterialDesignShadowDepth3}">
                            <StackPanel Width="320">
                                <TextBlock Text="{x:Static properties:Resources.SaveDialogTitle}"
                                           Style="{StaticResource ModernSectionHeader}" Margin="0,0,0,20"/>
                                <TextBox x:Name="HTMLNameTextBox"
                                         materialDesign:HintAssist.Hint="{x:Static properties:Resources.HTML文件名称}"
                                         Margin="0,0,0,20"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="CancelAddModel" Content="{x:Static properties:Resources.Common_Cancel}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"
                                            Click="CancelAddHTML_Click"/>
                                    <Button x:Name="ConfirmAddModel" Content="{x:Static properties:Resources.Common_Confirm}"
                                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                            Click="AddHtml_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static properties:Resources.CreatHTML_TabHTML}">
                <Grid Margin="24,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0" x:Name="htmlFileListBox"
                                 ItemsSource="{Binding HtmlFiles}"
                                 SelectedItem="{Binding SelectedHtmlFile}"
                                 Style="{StaticResource MaterialDesignListBox}"
                                 Margin="0,0,0,12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="1" HorizontalAlignment="Right"
                                Click="DeleteHtml_Click"
                                Style="{StaticResource MaterialDesignFlatButton}">
                            <materialDesign:PackIcon Kind="Delete"/>
                        </Button>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" x:Name="selectedHtmlContentTextBox"
                                 Text="{Binding SelectedHtmlContent, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="{x:Static properties:Resources.Common_Save}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Click="SaveHtml_Click" Margin="0,0,8,0" Cursor="Hand"/>
                            <Button Content="{x:Static properties:Resources.Common_Run}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Click="RunHtml_Click" Tag="OldAPP"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static properties:Resources.TAB_MODEL_MANAGEMENT}">
                <Grid Margin="28,20,28,20" MaxWidth="520">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Style="{StaticResource ModernSubHeader}" Text="{x:Static properties:Resources.Setting_O_MS}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <RadioButton x:Name="HTMLGlobalModel" Content="{x:Static properties:Resources.全局模型}"
                                         GroupName="HTMLMode" Margin="0,0,8,0"
                                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"/>
                            <RadioButton x:Name="HTMLSelectModel" Content="{x:Static properties:Resources.特定模型}"
                                         GroupName="HTMLMode" Margin="0,0,8,0"
                                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{x:Static properties:Resources.Ollama模型}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="OllamaModelSeletor" ItemsSource="{Binding OllamaModels}" DisplayMemberPath="Name"
                                      SelectedValuePath="ModelName" Style="{StaticResource MaterialDesignComboBox}"
                                      materialDesign:HintAssist.Hint="{x:Static properties:Resources.下拉选择模型}" FontSize="14"
                                      SelectionChanged="OllamaModelSeletor_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static properties:Resources.在线模型}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="OnlineModelSeletor" ItemsSource="{Binding OnlineModels}" DisplayMemberPath="ModelName"
                                      SelectedValuePath="Name" Style="{StaticResource MaterialDesignComboBox}"
                                      materialDesign:HintAssist.Hint="{x:Static properties:Resources.下拉选择模型}" FontSize="14"
                                      SelectionChanged="OnlineModelSeletor_SelectionChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Style="{StaticResource ModernSubHeader}" Text="{x:Static properties:Resources.模型}"/>
                        <TextBox x:Name="HTMLModel" Style="{StaticResource MaterialDesignTextBox}" FontSize="14" Margin="0,0,0,16"/>
                        <TextBlock Style="{StaticResource ModernSubHeader}" Text="EndPoint"/>
                        <TextBox x:Name="HTMLEndPoint" Style="{StaticResource MaterialDesignTextBox}" FontSize="14" Margin="0,0,0,16"/>
                        <TextBlock Style="{StaticResource ModernSubHeader}" Text="API KEY"/>
                        <PasswordBox x:Name="HTMLAPIKEY" FontSize="14" Margin="0,0,0,20"
                                     Style="{DynamicResource MaterialDesignRevealPasswordBox}"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                ToolTip="{x:Static properties:Resources.保存当前设置}"
                                HorizontalAlignment="Left"
                                Click="Model_Save_btn_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static properties:Resources.Common_Save}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
