<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== Apple-Inspired Design Tokens ========== -->

    <!-- Spacing -->
    <Thickness x:Key="PagePadding">32,24,32,24</Thickness>
    <Thickness x:Key="SectionPadding">24,20</Thickness>
    <Thickness x:Key="CardPadding">20,16</Thickness>
    <Thickness x:Key="ContentPadding">16,12</Thickness>

    <!-- Corner Radius -->
    <CornerRadius x:Key="BubbleCornerSmall">12</CornerRadius>
    <CornerRadius x:Key="UserBubbleCorner">18,18,4,18</CornerRadius>
    <CornerRadius x:Key="AgentBubbleCorner">18,18,18,4</CornerRadius>
    <CornerRadius x:Key="CardCorner">12</CornerRadius>
    <CornerRadius x:Key="InputCorner">12</CornerRadius>
    <CornerRadius x:Key="ButtonCorner">10</CornerRadius>

    <!-- Section Header -->
    <Style x:Key="ModernSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="ModernSubHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <Style x:Key="ModernCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <Style x:Key="ModernFocusRing" TargetType="Control">
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style TargetType="Control">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control">
                                <Border BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        Margin="-2"
                                        IsHitTestVisible="False"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apple-style card with subtle shadow -->
    <Style x:Key="ModernCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCorner}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="Effect" Value="{DynamicResource MaterialDesignShadowDepth1}"/>
    </Style>

</ResourceDictionary>
