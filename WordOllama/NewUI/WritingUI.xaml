<Window x:Class="WordOllama.NewUI.WritingUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WordOllama.NewUI"
        xmlns:properties="clr-namespace:WordOllama.Properties"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="14"
        Title="{x:Static properties:Resources.自由创作}" WindowStartupLocation="CenterScreen"
        d:DesignHeight="520" d:DesignWidth="860"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Inherit" PrimaryColor="Indigo" SecondaryColor="Indigo" ColorAdjustment="{materialDesign:ColorAdjustment}"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DataGrid.xaml" />
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <local:LoadingOverlay x:Name="thisProgressBar" Panel.ZIndex="9999" />

        <TabControl TabStripPlacement="Left" Padding="0" Margin="0">
            <TabItem Header="{x:Static properties:Resources.创作}">
                <Grid Margin="28,20,28,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Input pane -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" x:Name="ThemeTextBox"
                                 materialDesign:HintAssist.Hint="{x:Static properties:Resources.希望生成的文本主题}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>

                        <ComboBox Grid.Row="1" x:Name="TemplateComboBox"
                                  materialDesign:HintAssist.Hint="{x:Static properties:Resources.选择模板}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16"
                                  SelectionChanged="TemplateComboBox_SelectionChanged"/>

                        <Grid Grid.Row="2">
                            <TextBox x:Name="RequirementTextBox"
                                     materialDesign:HintAssist.Hint="{x:Static properties:Resources.具体创作需求}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     VerticalScrollBarVisibility="Auto" Padding="12,8,36,8"/>
                            <Button ToolTip="{x:Static properties:Resources.优化需求}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,14,12" Padding="4"
                                    MinWidth="0" MinHeight="0"
                                    Background="Transparent" BorderThickness="0"
                                    Click="OptimizationButton_Click">
                                <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <Button Grid.Row="3" x:Name="GenerateButton"
                                Content="{x:Static properties:Resources.开始生成}"
                                Click="GenerateButton_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,12,0,0"/>
                    </Grid>

                    <!-- Right: Output pane -->
                    <Grid Grid.Column="1" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="OutputTextBox" Grid.Row="0"
                                 materialDesign:HintAssist.Hint="{x:Static properties:Resources.内容生成区}"
                                 TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <Button x:Name="Copy_Btn" Grid.Row="1"
                                Click="Copy_Btn_Click" HorizontalAlignment="Right"
                                Margin="0,8,0,0" ToolTip="{x:Static properties:Resources.BUTTON_COPY_RESULT}">
                            <materialDesign:PackIcon Kind="ContentCopy"/>
                        </Button>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{x:Static properties:Resources.模板管理}">
                <Grid Margin="28,20,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="TemplateDataGrid"
                              ItemsSource="{Binding Templates}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static properties:Resources.模板名称}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="{x:Static properties:Resources.提示词需要点击格子三次}" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Prompt}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Prompt}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" Height="100"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PromptOptimizeIconButton}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                                                ToolTip="{x:Static properties:Resources.优化需求}"
                                                Click="OptimizeTemplateButton_Click">
                                            <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                Click="DeleteTemplateButton_Click"
                                                ToolTip="{x:Static properties:Resources.删除此模板}" Height="24" Width="24">
                                            <materialDesign:PackIcon Kind="Delete" Height="16" Width="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <Button Click="AddButton_Click" Margin="0,0,8,0" Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableRowPlusAfter" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static properties:Resources.新增}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveTemplatesButton" Click="SaveTemplatesButton_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static properties:Resources.Common_Save}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
