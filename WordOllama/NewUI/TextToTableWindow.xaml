<Window x:Class="WordOllama.NewUI.TextToTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:properties="clr-namespace:WordOllama.Properties"
        xmlns:local="clr-namespace:WordOllama.NewUI"
        mc:Ignorable="d"
        d:DesignHeight="520" d:DesignWidth="860"
        Title="{x:Static properties:Resources.文本转表格}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Ideal"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Inherit" PrimaryColor="Indigo" SecondaryColor="Indigo" ColorAdjustment="{materialDesign:ColorAdjustment}"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DataGrid.xaml" />
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <TabControl TabStripPlacement="Left" Padding="0" Margin="0">
        <TabItem Header="{x:Static properties:Resources.CreatHTML_TabAI}">
            <Grid Margin="28,20,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Input area -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" x:Name="InputTextBox"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             materialDesign:HintAssist.Hint="{x:Static properties:Resources.在此输入需要转换的文本}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,8,0"/>

                    <Grid Grid.Column="1" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ComboBox Grid.Row="0" x:Name="TemplateComboBox"
                                  materialDesign:HintAssist.Hint="{x:Static properties:Resources.选择模板}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12"
                                  SelectionChanged="TemplateComboBox_SelectionChanged"/>
                        <TextBox Grid.Row="1" x:Name="RequirementTextBox"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 materialDesign:HintAssist.Hint="{x:Static properties:Resources.在此输入格式内容等需求可选}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </Grid>
                </Grid>

                <!-- Action buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
                    <Button x:Name="GenerateButton" Click="GenerateButton_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TableSync" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static properties:Resources.生成表格}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="InsertToWordButton" Click="InsertToWordButton_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}" IsEnabled="False" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Microsoft" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{x:Static properties:Resources.插入到文档}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{x:Static properties:Resources.AI输出结果不稳定会导致生成失败可多次重试}"
                               VerticalAlignment="Center" Opacity="0.6" FontSize="12"/>
                </StackPanel>

                <!-- Preview -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Margin="0,0,0,8"
                               Text="{x:Static properties:Resources.表格预览}"/>

                    <DataGrid Grid.Row="1" x:Name="PreviewDataGrid"
                              AutoGenerateColumns="True" IsReadOnly="True"
                              materialDesign:DataGridAssist.CellPadding="13 8 8 8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8"/>
                </Grid>

                <!-- Progress -->
                <ProgressBar Grid.Row="3" x:Name="ProgressBar"
                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Height="2" IsIndeterminate="True" Visibility="Collapsed"/>

                <materialDesign:DialogHost x:Name="MainDialogHost" Identifier="MainDialogHost"/>
            </Grid>
        </TabItem>

        <TabItem Header="{x:Static properties:Resources.模板管理}">
            <Grid Margin="28,20,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="TemplateDataGrid"
                          ItemsSource="{Binding Templates}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static properties:Resources.模板名称}" Binding="{Binding Name}" Width="*"/>
                        <DataGridTemplateColumn Header="{x:Static properties:Resources.生成需求需要点击格子三次}" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Prompt}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Prompt}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" Height="100"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                            Click="DeleteTemplateButton_Click"
                                            ToolTip="{x:Static properties:Resources.删除此模板}" Height="24" Width="24">
                                        <materialDesign:PackIcon Kind="Delete" Height="16" Width="16"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}" Click="AddTemplateButton_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TableRowPlusAfter" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static properties:Resources.新增}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveTemplatesButton" Style="{StaticResource MaterialDesignRaisedButton}" Click="SaveTemplatesButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static properties:Resources.Common_Save}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
