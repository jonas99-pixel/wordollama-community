<Window x:Class="WordOllama.NewUI.DiffReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WordOllama.NewUI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{local:Loc I18n_DiffReviewTitle}" Height="580" Width="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Inherit" PrimaryColor="Indigo" SecondaryColor="Indigo" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Summary -->
        <TextBlock x:Name="lblSummary" Grid.Row="0" FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,12" Text="{local:Loc I18n_DiffLoadingStats}"/>

        <!-- Change list -->
        <Border Grid.Row="1" CornerRadius="12"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Margin="0,0,0,12">
            <ListView x:Name="changeList"
                      BorderThickness="0"
                      Background="Transparent"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.Resources>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                    </Style>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: type badge, index, old/new text -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding TypeBadge}" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ParagraphIndex, StringFormat='#'}"
                                           FontSize="11" Opacity="0.5" VerticalAlignment="Top" Margin="0,4,0,0"/>

                                <!-- Old text (read-only) -->
                                <Border Grid.Column="2" Margin="4,0" Background="#1AFF0000" CornerRadius="8" Padding="8,6" MinHeight="36">
                                    <StackPanel>
                                        <TextBlock Text="{local:Loc I18n_DiffBefore}" FontSize="9" Opacity="0.4" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding OldText}" TextWrapping="Wrap"
                                                   FontSize="12" Foreground="#CCCC0000" MaxHeight="80"/>
                                    </StackPanel>
                                </Border>

                                <!-- New text (editable for modification type) -->
                                <Border Grid.Column="3" Margin="4,0" Background="#1A00CC00" CornerRadius="8" Padding="8,6" MinHeight="36">
                                    <StackPanel>
                                        <TextBlock Text="{local:Loc I18n_DiffAfter}" FontSize="9" Opacity="0.4" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding NewText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 IsReadOnly="{Binding IsReadOnly}"
                                                 FontSize="12" Foreground="#CC00AA00"
                                                 MinHeight="20" MaxHeight="80"
                                                 Background="Transparent" BorderThickness="0"
                                                 Padding="0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 1: per-item action buttons -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="{local:Loc I18n_DiffAccept}" Tag="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                        Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0"
                                        Click="BtnAcceptChange_Click"/>
                                <Button Content="{local:Loc I18n_DiffReject}" Tag="{Binding}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="26" FontSize="11" Padding="10,0" Margin="0,0,6,0"
                                        Foreground="#FF453A" BorderBrush="#FF453A"
                                        Click="BtnRejectChange_Click"/>
                                <Button Content="{local:Loc I18n_DiffApplyEdit}" Tag="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Height="26" FontSize="11" Padding="10,0"
                                        Visibility="{Binding IsModification, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Click="BtnApplyEdit_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnAcceptAll" Content="{local:Loc I18n_DiffAcceptAll}"
                    Style="{StaticResource MaterialDesignFlatMidBgButton}"
                    Height="34" FontSize="13" Padding="16,0" Margin="0,0,8,0"
                    Click="BtnAcceptAll_Click"/>
            <Button x:Name="btnRejectAll" Content="{local:Loc I18n_DiffRejectAll}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="34" FontSize="13" Padding="16,0" Margin="0,0,8,0"
                    Click="BtnRejectAll_Click"/>
            <Button Content="{local:Loc I18n_Close}" Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="34" FontSize="13" Width="80"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
