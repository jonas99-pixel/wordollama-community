<UserControl x:Class="WordOllama.NewUI.ThinkPaneUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:properties="clr-namespace:WordOllama.Properties"
             xmlns:local="clr-namespace:WordOllama.NewUI"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="306"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextOptions.TextFormattingMode="Ideal"
             TextElement.FontSize="13"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Inherit" PrimaryColor="Indigo" SecondaryColor="Indigo" ColorAdjustment="{materialDesign:ColorAdjustment}"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Border Margin="12"
                BorderThickness="0"
                CornerRadius="12"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Effect="{DynamicResource MaterialDesignShadowDepth1}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0">
                <TextBox x:Name="ContentTextBox"
                         Style="{StaticResource MaterialDesignTextBox}"
                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                         Margin="14"
                         Padding="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         MinHeight="60"
                         BorderThickness="0"
                         FontSize="12"
                         Opacity="0.75"
                         Text="{x:Static properties:Resources.如果输出有思维链将会显示在这里}"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
