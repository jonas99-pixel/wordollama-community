<Window x:Class="WordOllama.NewUI.AgentPermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WordOllama.NewUI"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{local:Loc I18n_AgentPermissionTitle}"
        Width="560" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Inherit" PrimaryColor="Indigo" SecondaryColor="Indigo"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <materialDesign:PackIcon Kind="ShieldAlertOutline" Width="28" Height="28"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="{local:Loc I18n_AgentPermissionHeading}"
                           Style="{StaticResource ModernSectionHeader}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="PermissionMessage" TextWrapping="Wrap" LineHeight="22"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource MaterialDesignCardBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,18,0,20">
            <TextBlock Text="{local:Loc I18n_AgentPermissionSessionNote}"
                       TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{local:Loc I18n_Deny}" Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="36" Padding="20,0" Click="Deny_Click" IsCancel="True"/>
            <Button x:Name="AllowSessionButton" Content="{local:Loc I18n_AllowSession}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="36" Padding="20,0" Margin="8,0,0,0" Click="AllowSession_Click"/>
            <Button Content="{local:Loc I18n_AllowOnce}" Style="{StaticResource MaterialDesignFlatMidBgButton}"
                    Height="36" Padding="20,0" Margin="8,0,0,0" Click="AllowOnce_Click"/>
        </StackPanel>
    </Grid>
</Window>
