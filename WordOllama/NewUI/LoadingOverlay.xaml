<UserControl x:Class="WordOllama.NewUI.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WordOllama.NewUI"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             IsHitTestVisible="False">

    <Grid x:Name="OverlayRoot" Background="#7F000000" Visibility="Collapsed" IsHitTestVisible="True">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="16" Padding="32"
                Effect="{DynamicResource MaterialDesignShadowDepth3}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                <ProgressBar Margin="0,0,0,16"
                             HorizontalAlignment="Center"
                             IsIndeterminate="True"
                             Style="{DynamicResource MaterialDesignCircularProgressBar}"
                             Value="0"/>
                <TextBlock x:Name="MessageText" Text="{local:Loc I18n_LoadingPleaseWait}"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           FontSize="13" Opacity="0.7"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
