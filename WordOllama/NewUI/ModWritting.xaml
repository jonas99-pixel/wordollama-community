<Window x:Class="WordOllama.NewUI.ModWritting"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WordOllama.NewUI"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        d:DesignHeight="520" d:DesignWidth="860"
        Title="{local:Loc I18n_ModWritingTitle}"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Ideal"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Inherit" PrimaryColor="Indigo" SecondaryColor="Indigo" ColorAdjustment="{materialDesign:ColorAdjustment}"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DataGrid.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Expander.xaml" />
                <ResourceDictionary Source="ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <local:LoadingOverlay x:Name="thisProgressBar" Panel.ZIndex="9999" />

        <TabControl TabStripPlacement="Left" Padding="0" Margin="0">
            <TabItem Header="{local:Loc I18n_ModifyTab}">
                <Grid Margin="28,20,28,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Input -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="InputTextBox" Grid.Row="0"
                                 materialDesign:HintAssist.Hint="{local:Loc I18n_SourceTextArea}"
                                 TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="False"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <Grid Grid.Row="1" Margin="0,12,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0" x:Name="TemplateComboBox"
                                      materialDesign:HintAssist.Hint="{local:Loc I18n_SelectTemplate}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Margin="0,0,0,12"
                                      SelectionChanged="TemplateComboBox_SelectionChanged"/>

                            <Grid Grid.Row="1">
                                <TextBox x:Name="PromptBox"
                                         materialDesign:HintAssist.Hint="{local:Loc I18n_ModRequestHint}"
                                         TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="False"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="12,8,36,8"/>
                                <Button ToolTip="{local:Loc I18n_OptimizePrompt}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,4,4" Padding="4"
                                        MinWidth="0" MinHeight="0"
                                        Background="Transparent" BorderThickness="0"
                                        Click="OptimizationButton_Click">
                                    <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </Grid>

                        <Button Grid.Row="2" Content="{local:Loc I18n_StartModify}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Left" Click="ModifyButton_Click"/>
                    </Grid>

                    <!-- Right: Output -->
                    <Grid Grid.Column="1" Margin="12,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="OutputTextBox" Grid.Row="0"
                                 materialDesign:HintAssist.Hint="{local:Loc I18n_ModifyResult}"
                                 TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <Button x:Name="Copy_Btn" Grid.Row="1"
                                Click="Copy_Btn_Click" HorizontalAlignment="Right"
                                Margin="0,8,0,0" ToolTip="{local:Loc I18n_CopyResult}">
                            <materialDesign:PackIcon Kind="ContentCopy"/>
                        </Button>
                    </Grid>

                    <!-- Diff panel -->
                    <Grid Grid.Column="2">
                        <Expander ExpandDirection="Right">
                            <Expander.Header>
                                <TextBlock RenderTransformOrigin=".5,.5" Text="{local:Loc I18n_Compare}">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Expander.Header>
                            <StackPanel Margin="8,24,16,24" Orientation="Vertical"
                                        TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                                <TextBlock Text="{local:Loc I18n_BeforeAfterCompare}"/>
                                <RichTextBox x:Name="DiffBox" IsReadOnly="True"/>
                            </StackPanel>
                        </Expander>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{local:Loc I18n_TemplateManagement}">
                <Grid Margin="28,20,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="TemplateDataGrid"
                              ItemsSource="{Binding Templates}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{local:Loc I18n_TemplateName}" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="{local:Loc I18n_PromptClickThreeTimes}" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Prompt}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Prompt}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" Height="100"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PromptOptimizeIconButton}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"
                                                ToolTip="{local:Loc I18n_OptimizePrompt}"
                                                Click="OptimizeTemplateButton_Click">
                                            <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                Click="DeleteTemplateButton_Click"
                                                ToolTip="{local:Loc I18n_DeleteTemplate}" Height="24" Width="24">
                                            <materialDesign:PackIcon Kind="Delete" Height="16" Width="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <Button Margin="0,0,8,0" Style="{StaticResource MaterialDesignRaisedButton}" Click="AddTemplateButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableRowPlusAfter" VerticalAlignment="Center"/>
                                <TextBlock Text="{local:Loc I18n_Add}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveTemplatesButton" Style="{StaticResource MaterialDesignRaisedButton}" Click="SaveTemplatesButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center"/>
                                <TextBlock Text="{local:Loc I18n_Save}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
