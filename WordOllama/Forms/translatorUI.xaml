<UserControl x:Class="WordOllama.Forms.translatorUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:newUi="clr-namespace:WordOllama.NewUI"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="980"
             MinWidth="680" MinHeight="500"
             FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextOptions.TextFormattingMode="Ideal"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Inherit" PrimaryColor="Indigo" SecondaryColor="Indigo" ColorAdjustment="{materialDesign:ColorAdjustment}"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/WordOllama;component/NewUI/ModernStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TranslationLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Opacity" Value="0.68"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="TranslationTextButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <Style x:Key="TranslationEditor" TargetType="TextBox">
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="SpellCheck.IsEnabled" Value="True"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Language routing -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{newUi:Loc I18n_TranslationSourceLanguage}" Style="{StaticResource TranslationLabel}"/>
                    <ComboBox x:Name="SourceLangComboBox" MinHeight="48" IsEditable="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>
                <Button Grid.Column="1" Width="40" Height="40" Margin="6,24,6,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="{newUi:Loc I18n_SwapLanguages}" Click="SwapLanguages_Click">
                    <materialDesign:PackIcon Kind="SwapHorizontal" Width="20" Height="20"/>
                </Button>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{newUi:Loc I18n_TranslationTargetLanguage}" Style="{StaticResource TranslationLabel}"/>
                    <ComboBox x:Name="LangComboBox" MinHeight="48" IsEditable="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Terminology / style schemes. Kept folded by default to preserve a compact workspace. -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="0" Margin="0,0,0,12">
            <Expander x:Name="SchemeExpander" IsExpanded="False" Padding="14,0,14,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                        <materialDesign:PackIcon Kind="BookOpenVariant" Width="18" Height="18" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="{newUi:Loc I18n_TranslationScheme}" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{newUi:Loc I18n_OptionalCollapsed}" FontSize="11" Opacity="0.5"
                                   Margin="8,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SchemeComboBox" MinHeight="46" DisplayMemberPath="Name"
                                  SelectedValuePath="Id" SelectionChanged="SchemeComboBox_SelectionChanged"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        <Button Grid.Column="1" Content="{newUi:Loc I18n_ManageSchemes}" Margin="8,0,0,0"
                                Style="{StaticResource TranslationTextButton}" Click="ManageScheme_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="SchemeInstruction" MinHeight="58" MaxHeight="84"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="{newUi:Loc I18n_TranslationRequirementHint}"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Padding="12,10,42,10"/>
                        <Button Style="{StaticResource PromptOptimizeIconButton}"
                                ToolTip="{newUi:Loc I18n_OptimizePrompt}"
                                Tag="{Binding ElementName=SchemeInstruction}" Click="OptimizeScheme_Click">
                            <materialDesign:PackIcon Kind="AutoFix" Width="16" Height="16"/>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SchemeName" MinHeight="42" Margin="0,0,8,0"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="{newUi:Loc I18n_TranslationSchemeNameHint}"/>
                        <Button Grid.Column="1" Content="{newUi:Loc I18n_SaveMyScheme}" MinHeight="42" Padding="12,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Click="SaveScheme_Click"/>
                        <TextBlock Grid.Column="2" Text="{newUi:Loc I18n_UseAsDefaultScheme}"
                                   FontSize="11" Opacity="0.62" Margin="16,0,7,0"
                                   VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="3" x:Name="DefaultSchemeToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center" Checked="DefaultSchemeToggle_Changed"
                                      Unchecked="DefaultSchemeToggle_Changed"/>
                    </Grid>
                </StackPanel>
            </Expander>
        </Border>

        <!-- Source and translated text -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="16,13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{newUi:Loc I18n_TranslationSourceText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="InputCount" Text="0" Opacity="0.45" FontSize="11"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource TranslationTextButton}"
                                Click="LoadSelection_Click" ToolTip="{newUi:Loc I18n_LoadSelection}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TextBoxSearchOutline" Width="15" Height="15"/>
                                <TextBlock Text="{newUi:Loc I18n_LoadSelection}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource TranslationTextButton}"
                                Click="ClearInput_Click" ToolTip="{newUi:Loc I18n_Clear}">
                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource MaterialDesignBackground}"
                            CornerRadius="9" Padding="12" Margin="0,10,0,0">
                        <Grid>
                            <TextBlock Text="{newUi:Loc I18n_TranslationSourcePlaceholder}" Opacity="0.4"
                                       Margin="2" TextWrapping="Wrap" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=InputText, Path=Text}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="InputText" Style="{StaticResource TranslationEditor}"
                                     TextChanged="InputText_TextChanged"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="16,13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{newUi:Loc I18n_TranslationResult}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="OutputCount" Text="0" Opacity="0.45" FontSize="11"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource TranslationTextButton}"
                                Click="CopyOutput_Click" ToolTip="{newUi:Loc I18n_UiCopy}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="15" Height="15"/>
                                <TextBlock Text="{newUi:Loc I18n_UiCopy}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource MaterialDesignBackground}"
                            CornerRadius="9" Padding="12" Margin="0,10,0,0">
                        <Grid>
                            <TextBlock Text="{newUi:Loc I18n_TranslationOutputPlaceholder}" Opacity="0.4"
                                       Margin="2" TextWrapping="Wrap" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=OutputText, Path=Text}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="OutputText" Style="{StaticResource TranslationEditor}"
                                     TextChanged="OutputText_TextChanged"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.58"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                <ToggleButton x:Name="ComparisonModeToggle"
                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              ToolTip="{newUi:Loc I18n_ComparisonModeHint}"/>
                <TextBlock Text="{newUi:Loc I18n_ComparisonMode}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="TranslateButton" Height="42" MinWidth="138" Padding="20,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="TranslateBegin" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Translate" Width="18" Height="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{newUi:Loc I18n_StartTranslation}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
